# Copiar a .env en el servidor (chmod 600) y llenar. Nunca subir el .env al repo.
# URL con la que se abre Postiz en el navegador. Mientras solo escuche en 127.0.0.1:4007, se entra con
#   ssh -L 4007:127.0.0.1:4007 veridis-oficina   y se abre http://localhost:4007
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api
# Por http (sin TLS) las cookies necesitan esto; quitarlo cuando se publique con https.
NOT_SECURED=true
# Generar con: openssl rand -hex 32
JWT_SECRET=
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# Dejar en false hasta crear la cuenta de administración; luego true.
DISABLE_REGISTRATION=false
# Límite de la API pública por hora (por defecto de Postiz: 30 en este compose).
API_LIMIT=30
# Credenciales de cada red (apps de desarrollador propias; ver README.md). Vacías hasta tenerlas.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
