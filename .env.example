# Base dedicada; no usar las tablas del ERP.
DATABASE_URL=postgresql://veridis:CHANGE_ME@localhost:5432/veridis_agents
OPENAI_API_KEY=
# Seleccionar un modelo disponible con soporte de salidas estructuradas.
OPENAI_MODEL=
# Opcional: política por agente, capacidad y etapa; copia y edita el ejemplo.
# VERIDIS_MODELS_FILE=config/models.example.json
# Define identificadores reales disponibles en tus cuentas, con salida estructurada.
# VERIDIS_MODEL_ROUTINE=
# VERIDIS_MODEL_REASONING=
# VERIDIS_MODEL_RESEARCH=
# VERIDIS_MODEL_CODE=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Opcional: habilitar trazas solo tras revisar qué datos se enviarán.
LANGSMITH_TRACING=false
# API gobernada: receptor controlado con PUT/GET /deliveries/{key}.
# No se proporciona ni activa un destino externo por defecto.
# VERIDIS_DELIVERY_URL=http://127.0.0.1:4000/
# Reserva de costo por intento del modelo, en millonésimas de USD.
# Ajustar conforme a tarifa y límites; no es una tarifa verificada del proveedor.
# VERIDIS_MODEL_RESERVATION_MICROS=
# PORT=3000
# Límites del expediente (Defaults en src/runtime/contracts.ts es conservador a propósito:
# 15 min, 6 llamadas de modelo, 3 de herramienta, $0.10). Solo se amplían los que se definan aquí;
# solo aplican a expedientes creados después de iniciar el servidor con estos valores.
# VERIDIS_MAX_DURATION_MS=
# VERIDIS_MAX_MODEL_CALLS=
# VERIDIS_MAX_COST_MICROS=
# VERIDIS_MAX_TOOL_CALLS=
# Alternativa de dos proveedores: elegir modelos antes de activar el archivo.
# VERIDIS_MODELS_FILE=config/models.openai-deepseek.example.json
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Política activa con perfiles por tarea: config/models.active.json
# OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# OPENAI_COMPLEX_MODEL=gpt-5.4-2026-03-05
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Claude (perfiles claude-reasoning/claude-review de config/models.active.json): dos cuentas o
# claves distintas a propósito, para que coordinación del CEO y revisión general no comparta
# key/cuota entre sí ni con el resto de la política. Ver docs/model-routing.md.
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_API_KEY_2=
# CLAUDE_MODEL_2=claude-haiku-5-5

# Ollama local; la API local ignora esta clave de compatibilidad del SDK.
# OLLAMA_MODEL=huihui_ai/qwen3-coder-abliterated:30b
# OLLAMA_API_KEY=ollama
# Perfil "local-general" (config/models.active.json): especialistas sin herramientas reales,
# para que review() atrape en vivo una salida floja del modelo local antes de cualquier efecto
# real. Modelo corre en el VPS de oficina, no en este Mac (Ollama no es alcanzable aquí).
# OLLAMA_GENERAL_MODEL=huihui_ai/qwen3-abliterated:8b

# office/ real: reabre la ruta de ejecución real de la oficina (chat ASISTENTE y /office/orders).
# Una sola invocación puede encadenar varias llamadas reales; el tope siempre presente es de turnos.
# VERIDIS_OFFICE_ENABLED=true
# VERIDIS_OFFICE_MAX_TURNS=5
# Presupuesto opcional por expediente, en micros de la moneda de VERIDIS_PRICES_FILE (500000 = $0.50).
# Antes de cada llamada se proyecta la siguiente (la más cara de las últimas 5) y se pausa el
# expediente si rebasaría el tope. Exige un precio para cada provider:model usado: sin precio, el
# expediente se pausa en vez de gastar algo que no se puede medir.
# config/prices.active.json: precios oficiales verificados el 2026-10-31 de los modelos de
# config/models.active.json (DeepSeek con su tarifa de hora pico, la conservadora).
# VERIDIS_PRICES_FILE=config/prices.active.json
# VERIDIS_OFFICE_MAX_COST_MICROS=500000
# Tareas programadas: solo tiene efecto si office/ ya está habilitado arriba. Dispara expedientes
# reales sin que nadie le dé clic a nada, en la hora que cada tarea tenga configurada.
# VERIDIS_SCHEDULER_ENABLED=true
# VERIDIS_SCHEDULER_MAX_PER_HOUR=10

# Gmail real (email.draft/email.read, ver docs/assistant-v1-roadmap.md): OAuth propio de
# VeridisCorp, Client ID creado en Google Cloud Console (tipo "Aplicación web"), con exactamente
# http://localhost:8731/oauth2callback (o el puerto de abajo) en sus URIs de redirección
# autorizados. Nunca el conector de Gmail de ninguna sesión de Claude — ese usa registro dinámico
# de cliente, que los servidores de Google no soportan.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# VERIDIS_OAUTH_CALLBACK_PORT=8731
# Clave de cifrado del refresh token guardado en Postgres y de las credenciales de conexiones MCP
# (AES-256-GCM, 32 bytes en base64). Sin ella, las conexiones MCP sin credencial funcionan igual.
# Generar con: openssl rand -base64 32
# VERIDIS_TOKEN_ENCRYPTION_KEY=
# Autorización de un solo uso, con sesión de navegador iniciada en la cuenta dedicada de Gmail:
# npm run runtime:gmail-authorize

# Facebook/Instagram real (social.publish_facebook/social.publish_instagram, ver
# docs/social-publishing-roadmap.md): app propia creada en Meta for Developers (developers.facebook.com),
# con exactamente http://localhost:8732/oauth2callback (o el puerto de abajo) en sus URIs de
# redirección válidas del producto "Facebook Login". El usuario que autorice debe administrar la
# Página de Facebook real; Instagram debe ser una cuenta Business/Creator vinculada a esa Página.
# META_APP_ID=
# META_APP_SECRET=
# VERIDIS_META_OAUTH_CALLBACK_PORT=8732
# Solo si la cuenta administra más de una Página — sin esto, se usa la primera que devuelva Meta.
# META_PAGE_ID=
# Autorización de un solo uso: npm run runtime:meta-authorize

# Memoria corporativa (CorporateMemoryRecord, ver docs/governance-foundation.md): requiere la
# extensión pgvector instalada en el Postgres de destino (brew install pgvector en Mac; paquete
# postgresql-16-pgvector del repositorio PGDG en Linux) antes de correr runtime:db o test:postgres.
# Por defecto embebe con Ollama local (http://127.0.0.1:11434/v1, modelo nomic-embed-text, 768
# dimensiones) para no mandar el contenido de la memoria a ningún proveedor externo.
# VERIDIS_MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# VERIDIS_MEMORY_EMBEDDING_MODEL=nomic-embed-text
# Solo si se apunta a un proveedor real (p. ej. OpenAI text-embedding-3-small); Ollama ignora esta
# clave igual que OLLAMA_API_KEY arriba. Cambiar de proveedor exige migrar la columna vector(768).
# VERIDIS_MEMORY_EMBEDDING_API_KEY=
# Ámbito fijo de memory.write/memory.query (src/office/tools.ts): un solo AccessScope para todo el
# despliegue, igual que Gmail/Drive/Calendar usan una sola cuenta sin importar el cliente del
# expediente — no hay aislamiento real por cliente todavía (ver el comentario de configureMemory).
# VERIDIS_MEMORY_WORKSPACE_ID=veridiscorp
# VERIDIS_MEMORY_COMPANY_ID=642-studio
# VERIDIS_MEMORY_DIVISION_ID=general
# Vault de Obsidian: si se define, cada validación exitosa (POST /office/memory/{id}/validate)
# también escribe/sobreescribe <ruta>/<entityType>/<entityId>.md con el formato de memorias .md
# del proyecto CODE (AGENTS.md: título, backlinks [[...]], tags, fecha). Postgres sigue siendo la
# fuente de verdad — un fallo al escribir el archivo no revierte la validación, solo queda en la
# auditoría del expediente (evento memory.vault_export_failed). Ruta absoluta de un vault real de
# Obsidian en este equipo, o cualquier carpeta que luego abras como vault. Sin esta variable, no
# se escribe ningún archivo. Exportación manual de todo lo vigente: npm run runtime:memory-export
# VERIDIS_MEMORY_VAULT_PATH=

# Repositorios git que los puestos de software pueden LEER (repo.read: log, show, diff, status,
# búsqueda y lectura de archivos versionados). Nunca escriben. Formato: nombre=/ruta/absoluta,otro=/ruta
# VERIDIS_REPOS=veridiscorp=/home/usuario/VeridisCorp

# CRM de 642CORE que los puestos con "core.read" pueden LEER (clientes, contactos, marcas de
# lealtad, paquetes, estado VMI — src/office/core-tools.ts). Nunca escribe. Debe ser un rol de
# Postgres de solo lectura con GRANT SELECT únicamente en esas tablas (ver
# docs/sql/core_readonly_role.sql), nunca el service role de Supabase. Hoy esto es el Supabase
# en la nube de 642CORE; si algún día se migra a Postgres local, solo cambia esta URL.
# La MISMA variable/rol la usan también "tasks.read" (tareas, src/office/task-tools.ts) y
# "finance.read" (cuentas/facturas/transacciones, src/office/finance-tools.ts) — no hay
# credenciales nuevas, solo más GRANT SELECT en core_readonly (docs/sql/core_grants_tasks_finance.sql).
# CORE_DATABASE_URL=postgresql://core_readonly:CHANGE_ME@db.xxxxx.supabase.co:5432/postgres

# Escritura del CRM que los puestos con "core.write" pueden usar (crm_add_activity_note,
# crm_create_content_request, crm_create_contact — src/office/core-tools.ts). Conexión y rol
# separados de CORE_DATABASE_URL a propósito: este rol solo tiene GRANT INSERT en
# client_activity_log, content_requests y client_contacts, nunca UPDATE/DELETE ni otras tablas
# (ver docs/sql/core_write_role.sql). Sin IPv4 nativo, usar el connection pooler de Supabase
# (puerto 6543), no la conexión directa (puerto 5432).
# La MISMA variable/rol la usa también "tasks.write" (tasks_create, tasks_assign_user —
# src/office/task-tools.ts), con GRANT INSERT adicional en tasks/task_assignees
# (docs/sql/core_grants_tasks_finance.sql).
# CORE_WRITE_DATABASE_URL=postgresql://core_write:CHANGE_ME@db.xxxxx.supabase.co:6543/postgres

# Bot de Telegram para el chat ASISTENTE (src/runtime/telegram.ts), opcional: solo arranca si
# office/ está habilitado arriba y las dos variables siguientes están definidas. Long polling
# saliente hacia api.telegram.org — no abre ningún puerto nuevo. Actúa con el principal de servicio
# telegramBridge (mismo patrón que el scheduler), nunca con la identidad de quien escribe en
# Telegram — requiere un grant real para ese principal en la tabla grants (se añade incluyendo
# {"kind":"service","id":"telegram-bridge"} en los permissions de runtime:provision; ver
# config/runtime-session.example.json). Un mensaje de un chat_id fuera de la lista se ignora en
# silencio (queda en el log del servicio, nunca se responde).
# Token del bot, de @BotFather.
# TELEGRAM_BOT_TOKEN=
# IDs de chat autorizados a disparar expedientes reales, separados por coma. Para saber el tuyo:
# arranca el servicio sin esta variable, escríbele algo al bot, y busca el chat_id que queda
# registrado en los logs (journalctl -u veridiscorp) como "no autorizado".
# TELEGRAM_ALLOWED_CHAT_IDS=

# Voz (generate_voice, src/runtime/elevenlabs-proxy.ts) y música (generate_music,
# src/runtime/sunoapi-proxy.ts) reales para video-production. Sin ninguna de las dos, la
# herramienta correspondiente responde "no configurado" en vez de tumbar el servidor — igual que
# Gmail o ClickUp sin credencial. Ambas se cachean en veridis_runtime_v1.media_library: el mismo
# texto/estilo no se vuelve a generar ni a cobrar.
# VERIDIS_ELEVENLABS_API_KEY=
# VERIDIS_ELEVENLABS_VOICE_ID=
# VERIDIS_ELEVENLABS_MODEL_ID=
# VERIDIS_SUNOAPI_API_KEY=
