# Base dedicada; no usar las tablas del ERP.
DATABASE_URL=postgresql://veridis:CHANGE_ME@localhost:5432/veridis_agents
OPENAI_API_KEY=
# Seleccionar un modelo disponible con soporte de salidas estructuradas.
OPENAI_MODEL=
# Opcional: política por agente, capacidad y etapa; copia y edita el ejemplo.
# VERIDIS_MODELS_FILE=config/models.example.json
# Define identificadores reales disponibles en tus cuentas, con salida estructurada.
# VERIDIS_MODEL_ROUTINE=
# VERIDIS_MODEL_REASONING=
# VERIDIS_MODEL_RESEARCH=
# VERIDIS_MODEL_CODE=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Opcional: habilitar trazas solo tras revisar qué datos se enviarán.
LANGSMITH_TRACING=false
# API gobernada: receptor controlado con PUT/GET /deliveries/{key}.
# No se proporciona ni activa un destino externo por defecto.
# VERIDIS_DELIVERY_URL=http://127.0.0.1:4000/
# Reserva de costo por intento del modelo, en millonésimas de USD.
# Ajustar conforme a tarifa y límites; no es una tarifa verificada del proveedor.
# VERIDIS_MODEL_RESERVATION_MICROS=
# PORT=3000
# Límites del expediente (Defaults en src/runtime/contracts.ts es conservador a propósito:
# 15 min, 6 llamadas de modelo, 3 de herramienta, $0.10). Solo se amplían los que se definan aquí;
# solo aplican a expedientes creados después de iniciar el servidor con estos valores.
# VERIDIS_MAX_DURATION_MS=
# VERIDIS_MAX_MODEL_CALLS=
# VERIDIS_MAX_COST_MICROS=
# VERIDIS_MAX_TOOL_CALLS=
# Alternativa de dos proveedores: elegir modelos antes de activar el archivo.
# VERIDIS_MODELS_FILE=config/models.openai-deepseek.example.json
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Política activa con perfiles por tarea: config/models.active.json
# OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# OPENAI_COMPLEX_MODEL=gpt-5.4-2026-03-05
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# Ollama local; la API local ignora esta clave de compatibilidad del SDK.
# OLLAMA_MODEL=huihui_ai/qwen3-coder-abliterated:30b
# OLLAMA_API_KEY=ollama

# office/ real: reabre la ruta de ejecución real de la oficina (chat ASISTENTE y /office/orders).
# Una sola invocación puede encadenar varias llamadas reales; el tope es de turnos, no en dólares.
# VERIDIS_OFFICE_ENABLED=true
# VERIDIS_OFFICE_MAX_TURNS=5
# Tareas programadas: solo tiene efecto si office/ ya está habilitado arriba. Dispara expedientes
# reales sin que nadie le dé clic a nada, en la hora que cada tarea tenga configurada.
# VERIDIS_SCHEDULER_ENABLED=true
# VERIDIS_SCHEDULER_MAX_PER_HOUR=10

# Gmail real (email.draft/email.read, ver docs/assistant-v1-roadmap.md): OAuth propio de
# VeridisCorp, Client ID creado en Google Cloud Console (tipo "Aplicación web"), con exactamente
# http://localhost:8731/oauth2callback (o el puerto de abajo) en sus URIs de redirección
# autorizados. Nunca el conector de Gmail de ninguna sesión de Claude — ese usa registro dinámico
# de cliente, que los servidores de Google no soportan.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# VERIDIS_OAUTH_CALLBACK_PORT=8731
# Clave de cifrado del refresh token guardado en Postgres (AES-256-GCM, 32 bytes en base64).
# Generar con: openssl rand -base64 32
# VERIDIS_TOKEN_ENCRYPTION_KEY=
# Autorización de un solo uso, con sesión de navegador iniciada en la cuenta dedicada de Gmail:
# npm run runtime:gmail-authorize
