{
  "version": 1,
  "defaultProfile": "routine",
  "profiles": {
    "routine": {
      "provider": "openai",
      "baseURL": "https://api.deepseek.com",
      "modelEnv": "DEEPSEEK_MODEL",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxOutputTokens": 2000,
      "timeoutMs": 30000,
      "maxRetries": 0,
      "structuredOutputMethod": "jsonMode",
      "thinkingMode": "disabled"
    },
    "deepseek-code": {
      "provider": "openai",
      "baseURL": "https://api.deepseek.com",
      "modelEnv": "DEEPSEEK_MODEL",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxOutputTokens": 4000,
      "timeoutMs": 60000,
      "maxRetries": 0,
      "structuredOutputMethod": "jsonMode",
      "thinkingMode": "disabled"
    },
    "analysis": {
      "provider": "openai",
      "baseURL": "https://api.deepseek.com",
      "modelEnv": "DEEPSEEK_REASONING_MODEL",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxOutputTokens": 6000,
      "timeoutMs": 120000,
      "maxRetries": 0,
      "structuredOutputMethod": "jsonMode",
      "thinkingMode": "enabled"
    },
    "review": {
      "provider": "openai",
      "modelEnv": "OPENAI_MODEL",
      "apiKeyEnv": "OPENAI_API_KEY",
      "maxOutputTokens": 2000,
      "timeoutMs": 30000,
      "maxRetries": 0,
      "structuredOutputMethod": "functionCalling",
      "reasoningEffort": "none"
    },
    "complex": {
      "provider": "openai",
      "modelEnv": "OPENAI_COMPLEX_MODEL",
      "apiKeyEnv": "OPENAI_API_KEY",
      "maxOutputTokens": 6000,
      "timeoutMs": 120000,
      "maxRetries": 0,
      "structuredOutputMethod": "functionCalling",
      "reasoningEffort": "medium"
    },
    "gemini-flash": {
      "provider": "google",
      "modelEnv": "GEMINI_MODEL",
      "apiKeyEnv": "GEMINI_API_KEY",
      "maxOutputTokens": 4000,
      "timeoutMs": 60000,
      "maxRetries": 0
    },
    "uncensored": {
      "provider": "openai",
      "baseURL": "http://127.0.0.1:11434/v1",
      "modelEnv": "OLLAMA_MODEL",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "maxOutputTokens": 2000,
      "timeoutMs": 120000,
      "maxRetries": 0,
      "structuredOutputMethod": "jsonSchema"
    },
    "search-google": {
      "provider": "google",
      "modelEnv": "GEMINI_MODEL",
      "apiKeyEnv": "GEMINI_API_KEY",
      "maxOutputTokens": 2000,
      "timeoutMs": 30000,
      "maxRetries": 0
    }
  },
  "stages": {
    "coordinate": "complex",
    "execute": "routine",
    "review": "review"
  },
  "agents": {
    "ceo": {
      "coordinate": "complex"
    },
